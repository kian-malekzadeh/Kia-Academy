# Copy to .env.docker and adjust for your environment.
# Used by: docker compose --profile full up   (`pnpm docker:up`)
#
# PRODUCTION: replace ALL placeholder secrets before exposing the stack publicly.
# See SECURITY.md.

# PostgreSQL
POSTGRES_USER=kia_academy
# Use a strong unique password in production — never reuse the example value.
POSTGRES_PASSWORD=kia_academy
POSTGRES_DB=kia_academy
DATABASE_URL=postgresql://kia_academy:kia_academy@postgres:5432/kia_academy?schema=public

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=production
# Keep false in production (seed creates known demo passwords).
SEED_DATABASE=false
DB_HOST=postgres
DB_PORT=5432
DB_USER=kia_academy
TRUST_PROXY=true

# Auth — REQUIRED (min 32 chars; do not keep the placeholders below)
JWT_SECRET=replace-with-a-long-random-production-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_IN=7d
# OTP_DEV_EXPOSE must stay unset/false in production.

# Frontend: leave NEXT_PUBLIC_API_URL empty so the browser uses same-origin /api,
# proxied by Next.js to the API container.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PROXY_TARGET=http://api:3001

# Ports (optional overrides)
# API_PORT=3001
# WEB_PORT=3000
# POSTGRES_PORT=127.0.0.1:5432

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email / SMTP (optional — without it emails log to console + EmailLog table)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Kia Academy <noreply@kia.academy>