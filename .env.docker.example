# Copy to .env.docker and adjust for your environment.
# Used by: docker compose --profile full up   (`pnpm docker:up`)
#
# PRODUCTION: replace ALL placeholder secrets before exposing the stack publicly.
# See SECURITY.md.

# PostgreSQL
POSTGRES_USER=kia_academy
# REQUIRED. Generate with:  openssl rand -base64 24
POSTGRES_PASSWORD=kia_academy
POSTGRES_DB=kia_academy
# Keep user/password/db in sync with the three values above.
DATABASE_URL=postgresql://kia_academy:kia_academy@postgres:5432/kia_academy?schema=public

# Public edge (Caddy) — REQUIRED for the full stack
# Your domain pointing at this server (A/AAAA record). TLS certificates are
# issued automatically by Let's Encrypt.
# SITE_DOMAIN=kia.example.com
# Email for Let's Encrypt expiry/issue notices (recommended).
# ACME_EMAIL=ops@example.com

# API
PORT=3001
# Public HTTPS origin of the web app (comma-separated list supported).
CORS_ORIGIN=http://localhost:3000
# Same origin — used for absolute links in emails (password reset, receipts).
APP_URL=http://localhost:3000
NODE_ENV=production
# Keep false in production (seed creates known demo passwords).
SEED_DATABASE=false
DB_HOST=postgres
DB_PORT=5432
DB_USER=kia_academy
TRUST_PROXY=true

# Auth — REQUIRED (min 32 chars; do not keep the placeholders below)
JWT_SECRET=replace-with-a-long-random-production-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_IN=7d
# OTP_DEV_EXPOSE must stay unset/false in production.

# First super admin (RECOMMENDED for production) — set these ONCE before the
# first `docker:up`, then REMOVE both lines from .env.docker after logging in.
# The entrypoint creates the user only while the DB has zero SUPER_ADMINs;
# it never logs the password. Password minimum length: 12 characters.
# Generate a password with:  openssl rand -base64 24
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Frontend: leave NEXT_PUBLIC_API_URL empty so the browser uses same-origin /api,
# proxied by Next.js to the API container.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PROXY_TARGET=http://api:3001

# Ports (optional overrides — app/postgres/kuma ports are loopback-bound by
# default; only Caddy (80/443) is public). Bind overrides keep 127.0.0.1.
# API_PORT=127.0.0.1:3001
# WEB_PORT=127.0.0.1:3000
# POSTGRES_PORT=127.0.0.1:5432
# KUMA_PORT=127.0.0.1:3101

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email / SMTP (optional — without it emails log to console + EmailLog table)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Kia Academy <noreply@kia.academy>